# PostgreSQL
PG_USER=vms
PG_PASSWORD=changeme
PG_HOST=postgres
PG_PORT=5434
PG_HOST_PORT=5433

# Frigate NVR
FRIGATE_HOST=host.docker.internal
FRIGATE_RECORDINGS_PATH=/tmp/frigate-recordings

# Nx Witness
NX_BASE_URL=https://<nx-witness-ip>:7001
NX_HOST=<nx-witness-ip>
NX_USERNAME=admin
NX_PASSWORD=changeme
NX_RECORDINGS_PATH=/tmp/nx-recordings

# Live Video Captioning Core App
# FastAPI backend of the LVC stack (default port 4173)
LVC_HOST=host.docker.internal
LVC_BASE_URL=http://host.docker.internal:4173
# MediaMTX WebRTC signaling server (default port 8889)
MEDIAMTX_URL=http://host.docker.internal:8889

# Ports
BACKEND_PORT=8085
UI_PORT=3100

# VMS Plugin API
VMS_PLUGIN_API_KEY=

# MQTT Broker (eclipse-mosquitto in the LVC stack, port 1883)
MQTT_BROKER_HOST=host.docker.internal
MQTT_BROKER_PORT=1883

# OD/PDD MQTT — broker address as seen by VAP (for subscribing)
MQTT_HOST=host.docker.internal
MQTT_PORT=1883

# Broker address as seen by the Pipeline Server (for gvametapublish in the destination payload).
# Container name (e.g. mqtt-broker) may not resolve inside the GStreamer MQTT client (Paho C lib).
# Use the Docker bridge gateway IP of the PDD network, or the host machine's LAN IP.
# Both work because port 1883 is published on the host.
# Find the gateway: docker network inspect <pdd-network> | grep Gateway
PIPELINE_SERVER_MQTT_HOST=172.18.0.1
PIPELINE_SERVER_MQTT_PORT=1883
